    <!-- ========== 按钮样式（跟随主题色） ========== -->
    <style name="Widget.BrandButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">?attr/btnCorner</item>
        <item name="strokeWidth">?attr/btnStroke</item>
        <item name="strokeColor">?attr/lineColor</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.OutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">?attr/btnCorner</item>
        <item name="strokeWidth">?attr/btnStroke</item>
        <item name="strokeColor">?attr/lineColor</item>
        <item name="strokeColor">?attr/lineColor</item>
        <item name="android:textColor">?attr/textMain</item>
        <item name="android:textSize">14sp</item>
