<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ========== 默认（清爽蓝） ========== -->
    <style name="Theme.CaptureWords" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSecondaryVariant">@color/brand_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_dark</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>

        <item name="appBg">@color/app_bg</item>
        <item name="cardBackground">@drawable/bg_card</item>
        <item name="textMain">@color/text_primary</item>
        <item name="textSub">@color/text_secondary</item>
        <item name="textTertiary">@color/text_tertiary</item>
        <item name="lineColor">@color/line</item>
        <item name="cardSolid">@color/card</item>
        <item name="toolbarBg">@drawable/bg_toolbar</item>
        <item name="btnCorner">14dp</item>
        <item name="btnStroke">0dp</item>
    </style>

    <!-- ========== 星露谷（暖木色） ========== -->
