<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 硬投影 -->
    <item
        android:left="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>
    <!-- 主体 -->
    <item
        android:bottom="5dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF24331A" />
            <stroke
                android:width="3dp"
                android:color="#FF0B1206" />
        </shape>
    </item>
</layer-list>
